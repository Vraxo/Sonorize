<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sonorize-tui</AssemblyName>
    <RootNamespace>Sonorize.Tui</RootNamespace>
    <!-- Metadata -->
    <Product>Sonorize</Product>
    <Authors>Sonorize Contributors</Authors>
    <Company>Sonorize Contributors</Company>
    <Copyright>Copyright © 2025 Sonorize Contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sonorize.Core\Sonorize.Core.csproj" />
  </ItemGroup>

</Project>
