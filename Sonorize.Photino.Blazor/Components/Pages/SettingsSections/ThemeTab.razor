@using Sonorize.Core
@using Sonorize.Core.Services
@using Sonorize.Core.Services.UI
@using Sonorize.Core.Settings
@using Sonorize.Photino.Blazor.Components.Pages.Components
@using Sonorize.Photino.Blazor.Components.Pages.SettingsSections.Components
@using Sonorize.Photino.Blazor.Shared
@inject SonorizeSettings AppSettings
@inject ISettingsManager<SonorizeSettings> SettingsManager
@inject ThemeService ThemeService

<div class="settings-view-container">

    <!-- Saved Themes (full combo) -->
    <SettingsCard Title="Saved Themes" Description="Switch between presets that include both colors and layout">
        <HeaderAction>
            <button class="header-action-text-btn" @onclick="OpenSaveModal" title="Save Current as Full Theme">
                <i class="fas fa-save"></i> Save As...
            </button>
        </HeaderAction>
        <ChildContent>
            <ThemeListSection @ref="_themeList" OnLoadTheme="ApplyLoadedTheme" />
        </ChildContent>
    </SettingsCard>

    <!-- Color Schemes (independent) -->
    <SettingsCard Title="Color Scheme" Description="Change only the colors of the interface">
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <select @bind:get="_selectedColorTheme" @bind:set="OnColorThemeSelected" style="flex: 1; min-width: 150px;">
                @foreach (var colorTheme in _colorThemes)
                {
                    <option value="@colorTheme">@colorTheme</option>
                }
            </select>
            <button class="action-btn" @onclick="OpenSaveColorModal" title="Save current colors as new scheme">
                <i class="fas fa-save"></i> Save Colors...
            </button>
        </div>
    </SettingsCard>

    <!-- Layout Presets (independent) -->
    <SettingsCard Title="Layout Preset" Description="Change only the layout and behavior">
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <select @bind:get="_selectedLayoutTheme" @bind:set="OnLayoutThemeSelected" style="flex: 1; min-width: 150px;">
                @foreach (var layoutTheme in _layoutThemes)
                {
                    <option value="@layoutTheme">@layoutTheme</option>
                }
            </select>
            <button class="action-btn" @onclick="OpenSaveLayoutModal" title="Save current layout as new preset">
                <i class="fas fa-save"></i> Save Layout...
            </button>
        </div>
    </SettingsCard>

    <!-- Player Bar Layout -->
    <SettingsCard Title="Player Bar Layout" Description="Drag widgets to reorder or move between zones" ContentStyle="padding:0;">
        <div style="padding: 15px;">
            <PlayerBarLayoutEditor Config="AppSettings.Theme.PlayerBarLayout" OnChange="Save" />
        </div>
    </SettingsCard>

    <!-- Layout & Geometry -->
    <ThemeLayoutCard />

    <!-- Colors & Background -->
    <ThemeColorsCard />

</div>

<!-- Modals -->
<SaveThemeModal IsVisible="_showSaveModal" OnClose="CloseSaveModal" OnConfirm="ConfirmSaveTheme" />
<SaveThemeModal IsVisible="_showSaveColorModal" OnClose="CloseSaveColorModal" OnConfirm="ConfirmSaveColorScheme" Title="Save Color Scheme" />
<SaveThemeModal IsVisible="_showSaveLayoutModal" OnClose="CloseSaveLayoutModal" OnConfirm="ConfirmSaveLayoutPreset" Title="Save Layout Preset" />